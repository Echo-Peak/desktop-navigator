{
  "name": "desktop-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test:ext": "node --test \"BrowserExtensions/Chrome/**/*.test.js\"",
    "ci:set-version": "node scripts/ci/set-version.mjs",
    "ci:manifest": "node scripts/ci/manifest.mjs",
    "build:linux-deb": "tauri build --bundles deb",
    "build:linux-rpm": "tauri build --bundles rpm",
    "build:win-nsis": "tauri build --bundles nsis",
    "build:win-msi": "tauri build --bundles msi",
    "build:mac-zip": "tauri build --bundles app && node scripts/ci/package-macos.mjs zip",
    "build:mac-pkg": "tauri build --bundles app && node scripts/ci/package-macos.mjs pkg"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tauri-apps/api": "^2.1.1",
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
